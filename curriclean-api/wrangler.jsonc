/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "curriclean-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },

	/**
	 * api.curriclean.com is canonical. The older hosts keep working for
	 * webhooks and clients that still use them.
	 */
	"routes": [
		{ "pattern": "api.curriclean.com", "custom_domain": true },
		{ "pattern": "curriclean-api.rubrion.ai", "custom_domain": true }
	],
	"upload_source_maps": true,

	/**
	 * D1 SQLite database — primary datastore
	 * Create: wrangler d1 create curriclean
	 * Migrate: wrangler d1 migrations apply curriclean --remote
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "curriclean",
			"database_id": "8b9feee0-7564-4b9d-83dd-9aed0080e2f7",
			"migrations_dir": "migrations"
		}
	],

	/**
	 * KV namespace — daily token budget cache (KV-first, D1 authoritative)
	 * Create: wrangler kv namespace create curriclean-budget-kv
	 */
	"kv_namespaces": [
		{
			"binding": "BUDGET_KV",
			"id": "daac0ef61525468da7ca24749e9effae"
		}
	],

	/**
	 * Workers AI binding — LLM inference (@cf/google/gemma-4-26b-a4b-it)
	 * No provisioning needed; just declare the binding.
	 */
	"ai": { "binding": "AI" },

	/**
	 * Cloudflare Email Service — verification and password-reset emails.
	 * curriclean.com is onboarded for Email Sending (SPF/DKIM/DMARC managed by
	 * Cloudflare). `remote` makes `wrangler dev` send real email.
	 */
	"send_email": [{ "name": "EMAIL", "remote": true }],

	/**
	 * Secrets — set via: wrangler secret put <NAME>
	 *   JWT_SECRET          — HS256 signing secret for access tokens
	 *   AUTH_SHARED_SECRET  — server-to-server OAuth upsert secret
	 *   STRIPE_SECRET_KEY     — Stripe API key (credit packs)
	 *   STRIPE_WEBHOOK_SECRET — signing secret of the /stripe/webhook endpoint
	 */

	/**
	 * Non-sensitive runtime vars (safe to commit)
	 */
	"vars": {
		"DAILY_TOKEN_BUDGET": "50000",
		"CV_PDF_MAX_BYTES": "5242880",
		"FRONTEND_URL": "https://curriclean.com",
		"EMAIL_FROM": "no-reply@curriclean.com",
		"FREE_DAILY_CREDITS": "3",
		"UNLIMITED_FOR": "samuel@rubrion.ai",
		"STRIPE_PUBLISHABLE_KEY": "pk_test_51USlebQtpVVMufZy1dTBTIVsQyGJ9YJVbYn9DvISnBvlq1ibUMfgeFGIsRS5439uGIVPb6jp5qgoc77xwsHdXExu00TT5RghzL"
	}
}
