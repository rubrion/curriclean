# .dev.vars — local development secrets for `wrangler dev`
# Copy to .dev.vars and fill in values. NEVER commit .dev.vars.

# JWT signing secret (any long random string)
JWT_SECRET=your_jwt_secret_here

# Server-to-server OAuth upsert shared secret (must match frontend)
AUTH_SHARED_SECRET=your_auth_shared_secret_here

# Resend transactional email API key
RESEND_API_KEY=re_xxxxxxxxxxxx

# Sender address — must be a verified Resend domain, or use onboarding@resend.dev for dev
EMAIL_FROM=CurriClean <curriclean@rubrion.ai>

# Stripe (test mode keys for local dev). Checkout is disabled until all three are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
